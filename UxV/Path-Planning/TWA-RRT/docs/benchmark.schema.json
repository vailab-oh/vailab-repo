{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preserved TWA-RRT benchmark structure",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "world": {
            "type": "object",
            "properties": {
              "xlim": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "ylim": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "xlim",
              "ylim"
            ]
          },
          "start": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "goal": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "obstacles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "circle"
                },
                "cx": {
                  "type": "number"
                },
                "cy": {
                  "type": "number"
                },
                "r": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "type",
                "cx",
                "cy",
                "r"
              ]
            }
          },
          "time": {
            "type": "object",
            "properties": {
              "t_ref": {
                "type": "number"
              },
              "t_window": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "t_ref",
              "t_window"
            ]
          },
          "dynamics": {
            "type": "object",
            "properties": {
              "v_min": {
                "type": "number"
              },
              "v_max": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "a_max": {
                "type": "number"
              },
              "v0": {
                "type": "number"
              }
            },
            "required": [
              "v_min",
              "v_max",
              "a_max",
              "v0"
            ]
          },
          "random": {
            "type": "object",
            "properties": {
              "seed_base": {
                "type": "integer"
              },
              "num_trials": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "seed_base",
              "num_trials"
            ]
          },
          "planner": {
            "type": "object",
            "properties": {
              "n_iters": {
                "type": "integer",
                "minimum": 1
              },
              "goal_sample_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "step_size": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "neighbor_radius": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "n_iters",
              "goal_sample_rate",
              "step_size",
              "neighbor_radius"
            ]
          },
          "algorithms": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "outputs": {
            "type": "object",
            "properties": {
              "out_dir": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "out_dir"
            ]
          }
        },
        "required": [
          "case_id",
          "world",
          "start",
          "goal",
          "obstacles",
          "time",
          "dynamics",
          "random",
          "planner",
          "algorithms",
          "outputs"
        ]
      }
    }
  },
  "required": [
    "cases"
  ]
}